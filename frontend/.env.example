# API 엔드포인트
# 개발 환경
VITE_API_URL=http://127.0.0.1:8000

# 프로덕션 환경 (배포 시 주석 해제하고 실제 도메인으로 변경)
# VITE_API_URL=https://api.yourdomain.com

# Microsoft Entra ID (Azure AD) 연동 설정
VITE_ENTRA_CLIENT_ID=your-entra-client-id
VITE_ENTRA_TENANT_ID=your-entra-tenant-id

# 주의사항:
# - 프로덕션에서는 반드시 HTTPS를 사용하세요
# - 이 파일을 .gitignore에 추가하여 Git에 커밋하지 마세요
# - 민감한 정보 (API 키, 시크릿 등)를 이 파일에 저장하지 마세요
