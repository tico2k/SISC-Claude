# SICS(Fleit InsiderGuard) 환경 변수 설정 템플릿 (.env.example)
# 실제 운영 환경에서는 이 파일을 .env로 복사하여 사용하세요.

# [1] 데이터베이스 설정
# SQLite (기본): sqlite:///./sql_app.db
# PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./sql_app.db

# [2] 인증 및 보안 설정
# 반드시 강력한 시크릿 키로 변경하세요 
# (방법: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-secret-key-here
# JWT 토큰 만료 시간 (분)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 데이터 암호화 키 (로그/시크릿 보관용)
# 생성 방법: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-base64

# [3] CORS 설정
# 쉼표로 구분된 허용 origin 목록 (브라우저 주소)
CORS_ORIGINS=http://localhost:5173

# [4] 파일 업로드 설정
ALLOWED_FILE_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.txt,.png,.jpg,.jpeg,.gif
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# [5] Microsoft Entra ID (Azure AD) 연동 설정
# SSO 로그인 및 리디렉션을 위한 설정
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret
ENTRA_REDIRECT_URI=http://localhost:5173/auth-callback

# [6] 이메일 알림 설정
ENABLE_EMAIL_NOTIFICATIONS=true
# 전송 방식 선택: SMTP 또는 OUTLOOK
MAIL_SENDER_TYPE=OUTLOOK

# 발송 권한(Mail.Send)이 있는 실제 공용 사함함 주소
GRAPH_MAIL_SENDER=security@yourcompany.com

# [7] 애플리케이션 및 로깅
# 로깅 설정
# DEBUG, INFO, WARNING, ERROR, CRITICAL
APP_NAME=SICS
# 메일 본문 링크에 쓰는 프론트엔드 접속 주소 (미설정 시 CORS_ORIGINS의 첫 주소)
APP_URL=http://localhost:5173
LOG_LEVEL=INFO
DEBUG=false

# [8] 인증 방식 설정
# 자체 계정 로그인 허용 여부 (true/false)
ALLOW_LOCAL_LOGIN=true
# Microsoft Entra ID(SSO) 로그인 허용 여부 (true/false)
ALLOW_ENTRA_LOGIN=true
# 기본 인증 방식 (LOCAL 또는 ENTRA)
DEFAULT_AUTH_METHOD=LOCAL

# [9] 초기 관리자 계정 생성 정보 (최초 설치 시 1회 사용)
INITIAL_ADMIN_EMAIL=system@fleitlab.com
INITIAL_ADMIN_PASSWORD=password123
